// Android.bp — Build definition for CloudBridge
//
// Shared Kotlin module for cloud LLM communication.
// Author: Forge (Backend Lead, Agent Lab)

java_library {
    name: "CloudBridge",

    srcs: [
        "src/**/*.kt",
    ],

    sdk_version: "current",
    min_sdk_version: "34",

    static_libs: [
        "kotlinx-coroutines-core",
        "okhttp",
    ],
}
